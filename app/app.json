{
  "expo": {
    "name": "Hanger",
    "slug": "hanger",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "hanger",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0F0E0D",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hanger.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0E0D"
      },
      "package": "com.hanger.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hanger needs access to your photos so you can submit your kit for AI judging.",
          "cameraPermission": "Hanger needs camera access so you can shoot your kit for AI judging."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#EF3B3B"
        }
      ],
      "expo-font",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1b2eb03b-25cc-4989-a1f9-c8c92997b58f"
      }
    },
    "owner": "rubyrudii"
  }
}
